{
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,database.js,mailer.js,server.js,sms.js,wallet.js,wallet/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 9 * * *"
    }
  ]
}
