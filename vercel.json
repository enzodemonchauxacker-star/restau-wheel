{
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,lib/**,database.js,mailer.js,server.js,sms.js,wallet.js,wallet/**,prospector.js}",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.rekone.si" }],
      "destination": "https://rekone.si/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/prospects",
      "schedule": "0 7 * * 1"
    }
  ]
}
