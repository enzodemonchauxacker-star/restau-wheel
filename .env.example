# Neon Postgres (obligatoire — pooled URL recommandée)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# URL publique (QR codes)
PUBLIC_BASE_URL=https://restauwheel.com

# Sessions + super-admin
SESSION_SECRET=change-me
SUPERADMIN_PASSWORD=superadmin123

# Stripe (optionnel — sans ça, checkout en mode démo)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...

# Twilio SMS (relances J-7)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
# Préférer API Key (SK…) plutôt que Auth Token :
TWILIO_API_KEY=SKxxxxxxxx
TWILIO_API_SECRET=xxxxxxxx
# Ou legacy :
# TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM=+337xxxxxxxx
# 0 = aucun SMS (défaut) ; 1 = envois activés
SMS_ENABLED=0
# Mode test compte trial (templates Twilio uniquement)
TWILIO_TRIAL_TEMPLATES=1

PORT=3000
